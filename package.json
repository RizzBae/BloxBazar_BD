{
  "name": "bloxbazaar-bd",
  "version": "1.0.0",
  "private": true,
  "description": "BloxBazaar BD — storefront (static HTML/CSS/JS) plus the local backend service (Express admin/catalogue API, SQLite).",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "server": "node server/index.js",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "admin:reset": "node server/admin-reset.js",
    "test": "node --test \"server/test/**/*.test.js\"",
    "build:css": "tailwindcss -i assets/css/tailwind.src.css -o assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i assets/css/tailwind.src.css -o assets/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5"
  }
}
