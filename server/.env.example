# =========================================================
# BloxBazaar BD — backend environment (copy to server/.env)
# Every value below is optional; the defaults in server/config.js
# apply when it is missing. NEVER commit server/.env.
# =========================================================

# --- HTTP --------------------------------------------------
# PORT=4173
# HOST=127.0.0.1
# Set to 1 only behind a reverse proxy you control (enables trust proxy)
# BB_TRUST_PROXY=0

# --- Storage -----------------------------------------------
# BB_DB_PATH=server/data/bloxbazaar.db
# BB_UPLOADS_DIR=server/data/uploads

# --- Sessions (PRD §7) --------------------------------------
# BB_SESSION_IDLE_HOURS=12
# BB_SESSION_HOURS=12
# BB_SESSION_REMEMBER_DAYS=30
# auto | always | never — Secure cookies
# BB_COOKIE_SECURE=auto

# --- Sign-in lockout (PRD §8) --------------------------------
# BB_SIGNIN_ACCOUNT_MAX=5
# BB_SIGNIN_IP_MAX=10
# BB_SIGNIN_WINDOW_MIN=15

# --- Recovery-code lockout -----------------------------------
# BB_RECOVERY_ACCOUNT_MAX=5
# BB_RECOVERY_IP_MAX=12
# BB_RECOVERY_WINDOW_MIN=15

# --- Admin accounts & recovery ------------------------------
# Owners add admins from the dashboard's Team tab. Each admin can
# change their own email and password in Settings. No email is sent;
# a recovery code (generated in Settings, or printed by the CLI) is
# the fallback when a password is forgotten:
#   npm run admin:reset
#   npm run admin:reset -- --email other@example.com

# --- Rate limits (requests per window; 0 disables a limiter) --
# BB_PUBLIC_RATE_PER_MIN=120
# BB_ADMIN_READ_RATE_PER_MIN=240
# BB_ADMIN_WRITE_RATE_PER_MIN=60
# BB_UPLOAD_RATE_PER_HOUR=20
# Sign-in password checks and password-recovery attempts, per IP
# BB_AUTH_RATE_PER_MIN=20

# --- Seeded owner account (first run only) -------------------
# Used only when the database is created for the first time.
BB_SEED_ADMIN_EMAIL=owner@bloxbazaar.local
# Leave unset to have a strong random password generated and printed once by
# `npm run seed`. If you set it, keep it out of version control and change it
# after the first sign-in (Shop settings → Your account).
# BB_SEED_ADMIN_PASSWORD=
