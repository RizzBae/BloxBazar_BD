# =========================================================
# BloxBazaar BD — backend environment (copy to server/.env)
# Every value below is optional; the defaults in server/config.js
# apply when it is missing. NEVER commit server/.env.
# =========================================================

# --- HTTP --------------------------------------------------
# PORT=4173
# HOST=127.0.0.1
# Set to 1 only behind a reverse proxy you control (enables trust proxy)
# BB_TRUST_PROXY=0

# --- Storage -----------------------------------------------
# BB_DB_PATH=server/data/bloxbazaar.db
# BB_UPLOADS_DIR=server/data/uploads

# --- Sessions (PRD §7) --------------------------------------
# BB_SESSION_IDLE_HOURS=12
# BB_SESSION_HOURS=12
# BB_SESSION_REMEMBER_DAYS=30
# auto | always | never — Secure cookies
# BB_COOKIE_SECURE=auto

# --- Sign-in lockout (PRD §8) --------------------------------
# BB_SIGNIN_ACCOUNT_MAX=5
# BB_SIGNIN_IP_MAX=10
# BB_SIGNIN_WINDOW_MIN=15

# --- Rate limits (requests per window; 0 disables a limiter) --
# BB_PUBLIC_RATE_PER_MIN=120
# BB_ADMIN_READ_RATE_PER_MIN=240
# BB_ADMIN_WRITE_RATE_PER_MIN=60
# BB_UPLOAD_RATE_PER_HOUR=20

# --- Seeded owner account (first run only) -------------------
# CHANGE THE PASSWORD before any real use.
BB_SEED_ADMIN_EMAIL=owner@bloxbazaar.local
BB_SEED_ADMIN_PASSWORD=BloxBazaar@2026
